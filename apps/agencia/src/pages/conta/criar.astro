---
/**
 * **Criar a conta** — a 3.1 (A: uma página própria, com o topo do site; PO, 2026-10-16).
 *
 * A ilha é `client:load`: o formulário **é** a página, não há o que esperar rolar. `noindex`, como as outras páginas
 * da conta (`meta.ts`): o que se busca é a agência, não o formulário. A política de privacidade cobre a página pela
 * parte `conta` (`scripts/conferir-build.mjs`).
 *
 * A página soma o Turnstile à política de segurança: o cadastro leva o desafio, com a ação `cadastro`.
 */
import Pagina from '../../layouts/Pagina.astro'
import Topo from '../../componentes/Topo.astro'
import Rodape from '../../componentes/Rodape.astro'
import SemJavaScript from '../../componentes/SemJavaScript.astro'
import CriarConta from '../../ilhas/CriarConta'

import { SITE } from '../../conteudo/site'
import { politicaDaPagina, somarOTurnstile } from '../../conteudo/seguranca'
import '../../estilos/conta.css'

somarOTurnstile(politicaDaPagina(Astro.csp))
---

<Pagina titulo={`Criar sua conta — ${SITE.nome}`} indexar={false}>
  <Topo />
  <main id="conteudo-principal" class="conteudo conta">
    <CriarConta client:load />
    {/* O atendimento não cria conta: sem script, a saída é reservar com ele. */}
    <SemJavaScript oQue="a conta" paraQue="reservar" />
  </main>
  <Rodape />
</Pagina>
