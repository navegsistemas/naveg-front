---
/**
 * **A página.**
 *
 * Ela não tem conteúdo próprio: o que se lê vem de `conteudo/`, o que se desenha vem dos componentes, e o que
 * sobra aqui é a **ordem** — a única decisão que esta página toma.
 *
 * A alternância de fundo é derivada do índice, não escrita seção a seção. É o que faz inserir uma seção no meio
 * continuar certo sem ninguém recontar as faixas.
 */
import Pagina from '../layouts/Pagina.astro'
import Topo from '../componentes/Topo.astro'
import Secao from '../componentes/Secao.astro'
import Capa from '../componentes/Capa.astro'
import Atendimento from '../componentes/Atendimento.astro'
import Depoimentos from '../componentes/Depoimentos.astro'
import Rodape from '../componentes/Rodape.astro'
import Pendente from '../componentes/Pendente.astro'
import TotemDaAgencia from '../ilhas/TotemDaAgencia'

import { SECOES } from '../conteudo/secoes'

/** O que cada seção ainda espera. A entrada sai daqui quando o passo dela fecha. */
const PENDENCIAS: Readonly<Record<string, string>> = {}
---

<Pagina>
  <Topo />

  <main id="conteudo-principal">
    {
      SECOES.map((secao, indice) => (
        <Secao secao={secao} indice={indice}>
          {secao.id === 'capa' && <Capa />}
          {secao.id === 'atendentes' && <Atendimento />}
          {secao.id === 'depoimentos' && <Depoimentos />}
          {/* A única ilha da página: o código desce quando a seção entra na tela. */}
          {secao.id === 'totem' && <TotemDaAgencia client:visible modo="pagina" />}
          {
            secao.id === 'totem' && (
              <noscript>
                <p>
                  O totem de reserva precisa de JavaScript. Sem ele, fale direto com o atendimento pelos
                  contatos no fim da página.
                </p>
              </noscript>
            )
          }
          {secao.pendenteDoPasso !== null && (
            <Pendente passo={secao.pendenteDoPasso} descricao={PENDENCIAS[secao.id] ?? ''} />
          )}
        </Secao>
      ))
    }
  </main>

  <Rodape />
</Pagina>
