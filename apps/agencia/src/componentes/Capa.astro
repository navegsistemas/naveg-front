---
/**
 * **A capa.** O que a NAVEG faz, para quem, e as duas saídas.
 *
 * A ordem é de filtro: a travessia aparece no título, nas credenciais e nada mais precisa ser lido para alguém
 * saber se a página serve. A vitrine vem depois — ela convence quem já sabe que serve.
 *
 * O `<h1>` é o LCP desta página e é **texto**, não imagem: não há o que baixar antes de a primeira coisa
 * aparecer. Quando as fotos das embarcações chegarem, elas seguem abaixo da dobra e `loading="lazy"`.
 */
import { CAPA } from '../conteudo/capa'
import Icone from './Icone.astro'
import VitrineDeEmbarcacoes from './VitrineDeEmbarcacoes.astro'
---

<div class="capa">
  <h1 class="capa__titulo">{CAPA.titulo}</h1>
  <p class="capa__lead">{CAPA.lead}</p>

  <p class="capa__acoes">
    <a class="acao" href={CAPA.acaoPrimaria.href}>{CAPA.acaoPrimaria.rotulo}</a>
    <a class="acao acao--secundaria" href={CAPA.acaoSecundaria.href}>{CAPA.acaoSecundaria.rotulo}</a>
  </p>

  <ul class="credenciais">
    {
      CAPA.credenciais.map((credencial) => (
        <li class="credencial">
          <span class="credencial__icone">
            <Icone slug={credencial.icone} tamanho={22} />
          </span>
          <span class="credencial__texto">
            <strong class="credencial__valor">{credencial.valor}</strong>
            <span class="credencial__rotulo">{credencial.rotulo}</span>
          </span>
        </li>
      ))
    }
  </ul>

  <VitrineDeEmbarcacoes />
</div>

<style>
  .capa__titulo {
    max-width: 16ch;
  }

  .capa__lead {
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.25rem);
    color: var(--text-secondary);
    max-width: var(--largura-texto);
  }

  .capa__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
    max-width: none;
    margin-block: var(--espaco-4) var(--espaco-5);
  }

  .credenciais {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--espaco-3) var(--espaco-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credencial {
    display: flex;
    align-items: flex-start;
    gap: var(--espaco-3);
    padding-block: var(--espaco-2);
  }

  .credencial__icone {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    /* Laranja de preenchimento, com o marrom por cima — a regra medida do `tokens.css`. */
    background: var(--accent-superficie);
    color: var(--accent-contraste);
  }

  .credencial__texto {
    display: flex;
    flex-direction: column;
  }

  .credencial__valor {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--text);
  }

  .credencial__rotulo {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>
