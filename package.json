{
  "name": "naveg-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Agência virtual da NAVEG — Turismo e Logística. Single page institucional com o totem de reserva.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@naveg/agencia",
    "build": "npm run build --workspace=@naveg/agencia",
    "check": "npm run check --workspace=@naveg/agencia",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "verify": "npm run typecheck && npm run check && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
