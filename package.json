{
  "name": "naveg-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Agência virtual da NAVEG — Turismo e Logística. Single page institucional com o totem de reserva.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@navegsistemas/agencia",
    "build": "npm run build --workspace=@navegsistemas/agencia",
    "check": "npm run check --workspace=@navegsistemas/agencia",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "verify": "npm run typecheck && npm run check && npm run test",
    "conferir:build": "node scripts/conferir-build.mjs",
    "publicar:domain": "node scripts/publicar-domain.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
