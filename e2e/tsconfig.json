{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /* Quem lê estes arquivos é o Playwright, que resolve como um bundler; nada daqui é emitido. */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
